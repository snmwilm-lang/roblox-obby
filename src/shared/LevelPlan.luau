-- Difficulty curve inside a zone (index 1..20 -> 0..1)
local CURVE = {
	0.02, 0.08, 0.14, 0.2, 0.26, -- introduction + learning
	0.34, 0.39, 0.44, 0.49, 0.54, -- development
	0.6, 0.65, 0.7, 0.74, 0.78, -- difficulty
	0.83, 0.87, 0.9, -- mastery
	0.94, -- pre-final
	1.0, -- final stage
}

export type LevelInfo = {
	Level: number,
	Zone: number,
	Name: string,
	Main: string,
	Secondary: string,
	Challenge: string,
	Difficulty: number, -- 1.00 .. 10.99 (zone number + curve)
	Length: string,
	EstimatedSeconds: number,
	Checkpoint: boolean,
	FinalStage: boolean,
}

local LevelPlan = {}

function LevelPlan.get(level: number): LevelInfo
	local row = ROWS[level]
	assert(row, "No plan for level " .. tostring(level))
	local zone = CheckpointRules.zoneOf(level)
	local index = CheckpointRules.indexInZone(level)
	local final = CheckpointRules.isFinalStage(level)
	local preFinal = CheckpointRules.isPreFinal(level)

	local length
	local multiplier
	if final then
		length = "Final (x4)"
		multiplier = 4
	elseif preFinal then
		length = "Long"
		multiplier = 1.6
	elseif index <= 5 then
		length = "Short"
		multiplier = 0.8
	else
		length = "Medium"
		multiplier = 1
	end

	-- Base clear time grows with the zone (more pauses to read cycles, more retries)
	local base = 22 + zone * 5

	return {
		Level = level,
		Zone = zone,
		Name = row[1],
		Main = row[2],
		Secondary = row[3],
		Challenge = row[4],
		Difficulty = math.floor((zone + CURVE[index] * 0.99) * 100) / 100,
		Length = length,
		EstimatedSeconds = math.floor(base * multiplier + 0.5),
		Checkpoint = CheckpointRules.hasCheckpoint(level),
		FinalStage = final,
	}
end

function LevelPlan.name(level: number): string
	local row = ROWS[level]
	return row and row[1] or ("Level " .. level)
end

return LevelPlan
