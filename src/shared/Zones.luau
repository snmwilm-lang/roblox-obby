--[[
	Zones
	Identity of the 10 zones: name, difficulty label, palette, lighting, audio.

	Palette rule (see docs/GAME_DESIGN.md): zone colours only drive SAFE geometry
	and decoration. Semantic colours (danger red, moving amber, ghost cyan...)
	come from Palette and are identical in every zone.

	Music/ambience ids are left empty on purpose: paste asset ids you own or that
	are public in the Creator Store. Empty ids are simply skipped by AudioController.
]]

local rgb = Color3.fromRGB

export type LightingPreset = {
	ClockTime: number,
	Brightness: number,
	Ambient: Color3,
	OutdoorAmbient: Color3,
	ExposureCompensation: number,
	Atmosphere: { Density: number, Offset: number, Color: Color3, Decay: Color3, Glare: number, Haze: number },
	ColorCorrection: { TintColor: Color3, Saturation: number, Contrast: number, Brightness: number },
	Bloom: { Intensity: number, Size: number, Threshold: number },
	Clouds: { Cover: number, Density: number, Color: Color3 },
}

export type Zone = {
	Id: number,
	Name: string,
	Theme: string,
	Difficulty: string,
	DifficultyColor: Color3,
	Mechanic: string,
	Tagline: string,
	Safe: { Color: Color3, Material: Enum.Material },
	Structure: { Color: Color3, Material: Enum.Material },
	Accent: Color3,
	Foliage: Color3,
	Lighting: LightingPreset,
	Music: { SoundId: string, Volume: number },
	Ambience: { SoundId: string, Volume: number },
}

